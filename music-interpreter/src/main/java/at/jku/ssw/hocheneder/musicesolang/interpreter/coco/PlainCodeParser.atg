COMPILER PlainCode



CHARACTERS
// Declare character sets (such as number or word).
letter = 'a'..'z' + 'A'..'Z' .
digit = "0123456789" .



TOKENS
// Specify the tokens (or terminal symbols) of the language (such as number or ident) by using the character set defined above.
number = ["-"] digit { digit }.
ident = letter { letter | digit }.

COMMENTS FROM "(*" TO "*)" // Multi-line comments should go from (* to *)
COMMENTS FROM "//" TO "\n" // Single-line comments should go from // to \n
IGNORE '\r' + '\t' // Ignore following symbols as whitespace: \r and \t.

PRODUCTIONS
    PlainCode =
        [Label | Instruction]
        {"\n" {"\n"} (Label | Instruction)}
        .

    OpCode<out int op> = ident (. if (OPCODES.contains(t.val)) { op = OPCODES.get(t.val); } else { op = -1; SemErr("Unknown opcode: " + t.val); } .)
        .

    Instruction =               (. boolean arg = false; .)
        OpCode<out int op>      (. code.put(op); .)
        [ (number               (. code.put(Integer.parseInt(t.val)); arg = true;.)
            | ident )           (. if (op == Code.JMP_x) { code.put(0); code.getLabel(t.val).sourceHere(); } else {SemErr("Number expected for opcode " + OPCODES.get(op));} .)
        ]                       (. if (code.hasArg(op) && !arg) {
                                    SemErr("Argument expected for opcode " + OPCODES.get(op));
                                } else if (!code.hasArg(op) && arg) {
                                    SemErr("No argument expected for opcode " + OPCODES.get(op));
                                } .)
        .

    Label =
        ":" ident               (. code.getLabel(t.val).targetHere(); .)
        .

END PlainCode.
